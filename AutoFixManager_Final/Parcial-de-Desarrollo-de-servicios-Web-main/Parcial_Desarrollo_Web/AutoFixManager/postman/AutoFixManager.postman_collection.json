{
  "info": {
    "name": "AutoFix Manager API",
    "description": "Pruebas CRUD, JWT con refresh token rotatorio, relación muchos-a-muchos, procedimiento almacenado y aislamiento por rol. Ejecutar en orden; los usuarios y datos reciben un sufijo único por corrida.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "clienteId",
      "value": ""
    },
    {
      "key": "clienteId2",
      "value": ""
    },
    {
      "key": "vehiculoId",
      "value": ""
    },
    {
      "key": "servicioId",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "mecanicoId",
      "value": ""
    },
    {
      "key": "mecanicoId2",
      "value": ""
    },
    {
      "key": "usuarioMecanicoId",
      "value": ""
    },
    {
      "key": "usuarioClienteId",
      "value": ""
    },
    {
      "key": "servicioMecanicoId",
      "value": ""
    },
    {
      "key": "tokenMecanico",
      "value": ""
    },
    {
      "key": "tokenMecanico2",
      "value": ""
    },
    {
      "key": "tokenCliente",
      "value": ""
    },
    {
      "key": "runSuffix",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Autenticación y permisos",
      "item": [
        {
          "name": "Login ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombreUsuario\": \"admin\",\n  \"contrasena\": \"Admin123*\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login ADMIN correcto', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('token', pm.response.json().token);",
                  "pm.collectionVariables.set('runSuffix', Date.now().toString().slice(-6));"
                ]
              }
            }
          ]
        },
        {
          "name": "Renovar JWT ADMIN con refresh token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh token rotatorio HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('La respuesta contiene un nuevo access token', () => pm.expect(pm.response.json().token).to.be.a('string').and.not.empty);",
                  "pm.collectionVariables.set('token', pm.response.json().token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear usuario MECANICO",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n \"nombreUsuario\":\"mecanico{{runSuffix}}\",\n \"contrasena\":\"Mecanico123*\",\n \"rol\":\"MECANICO\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ADMIN puede crear usuario', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('mecanicoId', pm.response.json().id);",
                  "pm.collectionVariables.set('usuarioMecanicoId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Crear segundo usuario MECANICO para relación muchos-a-muchos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n \"nombreUsuario\":\"mecanico2{{runSuffix}}\",\n \"contrasena\":\"Mecanico123*\",\n \"rol\":\"MECANICO\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/usuarios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('ADMIN crea segundo mecánico HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('mecanicoId2', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar clientes con token ADMIN",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/clientes"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Token ADMIN autorizado', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar clientes sin token (debe ser 401)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/clientes",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Ruta protegida sin token', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    },
