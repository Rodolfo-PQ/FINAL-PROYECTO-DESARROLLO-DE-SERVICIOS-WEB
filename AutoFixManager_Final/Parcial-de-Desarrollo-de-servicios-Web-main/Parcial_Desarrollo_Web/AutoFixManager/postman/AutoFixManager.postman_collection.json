            "url": "{{baseUrl}}/api/servicios"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Servicio creado HTTP 201', () => pm.response.to.have.status(201));",
                  "pm.test('La orden conserva los dos mecánicos asignados', () => pm.expect(pm.response.json().mecanicosAsignados).to.have.lengthOf(2));",
                  "pm.collectionVariables.set('servicioId', pm.response.json().id);"
